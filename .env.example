# ============================================================
# WebCafe SEO 新词监控与飞书推送服务配置模板 (.env.example)
# 使用说明：复制此文件为 .env，并填入你的实际密钥与配置参数
# ============================================================

# 1. 哥飞 SEO 工具箱 (WebCafe) API 配置
# 在 https://seo.web.cafe 个人中心获取 MCP Token
WEBCAFE_API_BASE="https://seo.web.cafe/api/v1"
WEBCAFE_TOKEN="your_webcafe_mcp_token_here"

# 2. AI 门禁大模型配置 (用于判定关键词是否具备付费软件场景)
# 默认使用 DeepSeek API 进行二元分类与策略归纳
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# 3. 飞书开放平台应用配置 (可选：用于飞书独立机器人推送 / 多维表格同步)
# 在飞书开放平台 (https://open.feishu.cn) 创建企业自建应用获取
FEISHU_APP_ID="your_feishu_app_id"
FEISHU_APP_SECRET="your_feishu_app_secret"
FEISHU_BITABLE_APP_TOKEN="your_feishu_bitable_app_token"
FEISHU_BITABLE_TABLE_ID="your_feishu_bitable_table_id"
FEISHU_CHAT_ID="your_feishu_chat_id"

# 4. cc-connect 会话配置 (可选：如果使用 cc-connect 管道推送)
CC_CONNECT_SESSION_KEY="feishu:your_chat_id:your_user_id"
